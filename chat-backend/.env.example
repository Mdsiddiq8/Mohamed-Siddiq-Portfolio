# Copy to .env and fill in. With none of these set the backend runs in MOCK mode
# (logs instead of sending WhatsApp, canned replies instead of an LLM).

# Mohamed's own WhatsApp number, digits only with country code
OWNER_WHATSAPP_NUMBER=918524807305

# WhatsApp Cloud API (Meta for Developers -> your app -> WhatsApp)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=choose-any-long-random-string
WHATSAPP_APP_SECRET=

# Approved template with 3 quick-reply buttons, used when the 24h window is closed (see README)
WHATSAPP_TEMPLATE_NAME=portfolio_visitor_message
WHATSAPP_TEMPLATE_LANG=en

# AI assistant (any OpenAI-compatible API)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Email notification on every visitor message (resend.com, free tier)
RESEND_API_KEY=
RESEND_FROM=Portfolio <onboarding@resend.dev>
NOTIFY_EMAIL=mohamedsiddiq688@gmail.com

# Seconds to wait for Mohamed before the AI assistant answers
AUTO_REPLY_DELAY_SECONDS=15

# Your website origin(s), comma separated. Use * only while testing.
ALLOWED_ORIGINS=https://your-portfolio-domain.com
DB_PATH=chat.db
